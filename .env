# Unified openstreetmap-website + osm-carto4mc stack
#
# Copy to `.env` (already committed in this repo) and adjust as needed.
# Every value here has a safe default in docker-compose.yml.

# --- Ports exposed on the host -------------------------------------------
# 入口反代（edge）：站点 / API / iD / 瓦片全部走这一个端口。
# 内网穿透只需要映射它。
EDGE_PORT=3000
# Rails 直连端口（仅调试用）。页面里的瓦片地址是根相对路径，只有经过 edge
# 才有图，所以 3001 上打开站点地图是空的，属预期。
WEB_PORT=3001
# PostgreSQL (single instance holding BOTH the API db and the render db)
DB_PORT=54321
# renderd + mod_tile tile server（edge 会代转 /tile/，一般不必单独穿透）
TILE_PORT=8080
DYN2XYZ_PORT=8090

# dyn2xyz 构建时用的 PyPI 源。官方源在本机经常超时，换成清华镜像。
# 换回官方源：PIP_INDEX_URL=https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- 瓦片地址（浏览器用的那个）-------------------------------------------
# 这里**没有**开关可调：浏览器拿到的瓦片地址写在
#   openstreetmap-website/config/layers.yml      (tileUrl，主站地图)
#   openstreetmap-website/config/id_imagery.yml  (template，iD 底图清单)
# 两处都是根相对路径（/tile/... 与 /tiles/...），由 edge 反代转发到
# tileserver / dyn2xyz。改完 layers.yml 需要 `docker compose restart web`
# 重建前端 bundle（id_imagery.yml 是请求时读的，刷新页面即可）。
#
# 以前这里有个 TILE_URL_BASE=http://localhost:8080/tile —— 提醒：它**没有任何
# 代码读取**，改它不会有任何效果；真正生效的只有上面那两个文件。

# --- Database names (inside the single PostgreSQL instance) --------------
API_DB=openstreetmap
API_USER=openstreetmap
API_PASSWORD=openstreetmap
GIS_DB=gis
GIS_USER=postgres

# --- Incremental synchronisation ----------------------------------------
# How often the sync service looks for new changesets (seconds).
SYNC_INTERVAL=60
# Also keep a standards shaped replication directory (state.txt + NNN.osc.gz)
# under ./data/replication so other consumers can replay the same changes.
KEEP_REPLICATION_FILES=true
# Drop the mod_tile cache whenever new data has been applied, so the next
# tile request re-renders. Cheap for small/medium instances.
PURGE_TILES_ON_SYNC=true

# --- osm2pgsql tuning ----------------------------------------------------
OSM2PGSQL_CACHE=1024
OSM2PGSQL_NUMPROC=4

# --- Download robustness -------------------------------------------------
# osm-carto4mc's get-fonts.py / get-external-data.py make HTTP requests
# without a timeout, so one stalled TCP connection hangs them forever. Each
# attempt is bounded and retried, and every individual HTTP request gets its
# own timeout + retry/backoff (see sync/reliable_run.py).
FONT_DOWNLOAD_TIMEOUT=1800
EXTERNAL_DATA_TIMEOUT=7200
DOWNLOAD_ATTEMPTS=3
DOWNLOAD_REQUEST_TIMEOUT=60
DOWNLOAD_REQUEST_RETRIES=5
# Skip re-downloading the ~100 MB Noto font set when the font directory already
# holds at least this many files (it is shared between environments).
FONTS_MIN_FILES=40
#FORCE_FONTS=true

# --- Bootstrap behaviour -------------------------------------------------
# auto  : import into the render db the first time the stack starts
# never : only sync, assume the render db already exists
# force : rebuild the render db from the API db on every start
BOOTSTRAP=auto
# Set to false to skip the (large, ~1 GB) Natural Earth / water polygon
# downloads during bootstrap. Rendering will fail for those layers.
LOAD_EXTERNAL_DATA=true
# Set to false to skip downloading the Noto fonts during bootstrap.
LOAD_FONTS=true
