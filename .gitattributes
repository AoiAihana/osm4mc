# 统一换行；本项目只在 Linux 上跑
* text=auto eol=lf

# 二进制（别让 git 试图 diff / 合并）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.npy   binary
*.npz   binary
*.dump  binary
*.tar   binary
*.gz    binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.otf   binary
*.ttf   binary
# SVG 是文本，参与 diff 更利于审阅
*.svg text

