# Production environment.
#
# This file is NOT loaded automatically: it is passed explicitly with
# `--env-file` (see docker-compose.prod.yml / tools/switch-env.sh), so the
# development stack keeps using `.env`.
#
# SECRET_KEY_BASE is intentionally empty here: `./tools/switch-env.sh prod
# --init` generates one and writes it into `.env.prod` (which is gitignored;
# this file is the tracked template).

# --- host ports ----------------------------------------------------------
# Deliberately the SAME as development: the two environments are meant to be
# switched, not run side by side. Change them if you do want both at once.
#
# EDGE_PORT is the only port the outside world needs: it is the reverse proxy
# that fronts the site, /tile/ (renderd/mod_tile) and /tiles/ (dyn2xyz).
# WEB_PORT is Rails' direct port and is for debugging only - the tile URLs in
# the pages are root-relative, so a browser talking to Rails directly gets a
# 404 for every tile. That is expected.
EDGE_PORT=3000
WEB_PORT=3001
TILE_PORT=8080
DYN2XYZ_PORT=8090
DB_PORT=54321

# The tile URL the browser uses is no longer configurable from here (this file
# used to carry a TILE_URL_BASE that no code ever read): it lives, as a
# root-relative path, in
#   openstreetmap-website/config/layers.yml      (main site map)
#   openstreetmap-website/config/id_imagery.yml  (iD basemap list)
# so that one configuration works for localhost, the LAN address and whatever
# address the tunnel hands out.

# --- storage -------------------------------------------------------------
# Production gets its own PostgreSQL container and volume, so it is isolated
# from development even though the database name is the same.
DB_VOLUME=osm-prod-db-data
WEB_TMP_VOLUME=osm-prod-web-tmp
WEB_STORAGE_VOLUME=osm-prod-web-storage

# Its own render/sync/tile state ...
DATA_DIR=./data/prod
# ... but the downloaded fonts are shared, since they are identical and cost
# about 100 MB to fetch.
FONTS_DIR=./data/fonts

# --- Rails ---------------------------------------------------------------
SECRET_KEY_BASE=
RAILS_LOG_LEVEL=info

# --- sync ----------------------------------------------------------------
SYNC_INTERVAL=30
OSM2PGSQL_CACHE=1024
OSM2PGSQL_NUMPROC=4
BOOTSTRAP=auto
# The font directory is shared with development and already holds the full set,
# so the download is skipped; set FORCE_FONTS=true to refresh it.
FONTS_MIN_FILES=40

# --- first administrator (used by tools/prod-init.rb) --------------------
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
# Leave unset to have a random password generated and printed once.
#ADMIN_PASSWORD=
